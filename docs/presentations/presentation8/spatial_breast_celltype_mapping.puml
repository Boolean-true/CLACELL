rectangle "Endothelial cell" as C_ENDO #E53935
rectangle "Stromal cell" as C_STR #C2185B
rectangle "Myeloid cell" as C_MYE #FB8C00
rectangle "Plasma cell" as C_PLASMA #8D6E63
